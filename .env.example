# Скопируйте в .env.local для локальной разработки.
# На Vercel эти же две переменные добавляются в Settings → Environment Variables.
#
# Оба значения лежат в Supabase → Project Settings → API.
# Ключ anon публичный — его можно держать во фронтенде.
# Ключ service_role сюда вставлять НЕЛЬЗЯ.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Адрес сайта. Необязательно.
# Нужен только для карты сайта (sitemap.xml). Пока не задан, карта не создаётся.
# На продакшн-сборке Vercel подставляет адрес сам, так что вписывать сюда
# что-либо стоит только когда появится собственный домен.
# VITE_SITE_URL=https://ваш-домен

# Форма заявки ("Leave a request") на сайте отправляет письмо напрямую из
# браузера через Web3Forms (https://web3forms.com) — без бэкенда, поэтому
# ключ ОБЯЗАН быть с префиксом VITE_, иначе Vite не положит его в сборку.
# Это не секрет в привычном смысле: Web3Forms спроектирован так, что этот
# ключ виден в браузере — от спама/чужого использования защищает сам
# сервис (домен подтверждается в личном кабинете).
#
# 1. Зарегистрируйтесь на https://web3forms.com письмом
#    cookiekiller.design@gmail.com — ключ придёт на почту сразу после
#    регистрации (и есть в личном кабинете на сайте).
# 2. Впишите его сюда и в Vercel → Settings → Environment Variables →
#    VITE_WEB3FORMS_ACCESS_KEY, отметить Production + Preview + Development.
# 3. Deployments → ⋯ → Redeploy — без пересборки сайт старый ключ не увидит.
VITE_WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
